PREFIX ftm: <https://w3id.org/anon-e2/ftm#>
# Label rate per source: persons recorded by exactly one source graph, positives = persons for which any other
# named graph asserts the topic "sanction".
SELECT ?g (COUNT(DISTINCT ?p) AS ?persons) (COUNT(DISTINCT ?pos) AS ?positives)
       (COUNT(DISTINCT ?pos) / COUNT(DISTINCT ?p) AS ?labelRate)
WHERE {
  GRAPH <https://w3id.org/anon-e2/graph/meta> { ?g ftm:role "source" }
  GRAPH ?g { ?p a ftm:Person }
  FILTER NOT EXISTS { GRAPH <https://w3id.org/anon-e2/graph/meta> { ?g2 ftm:role "source" }
                      GRAPH ?g2 { ?p a ftm:Person } FILTER (?g2 != ?g) }
  OPTIONAL { GRAPH ?lg { ?p ftm:topic "sanction" } BIND(?p AS ?pos) }
}
GROUP BY ?g ORDER BY DESC(?labelRate)
